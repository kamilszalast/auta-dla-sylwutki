{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/run?turn=1",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/run?turn=2",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/run?turn=3",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/run.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,index.html,.github/**}"
    },
    "api/data.py": {
      "maxDuration": 15,
      "excludeFiles": "{tests/**,index.html,.github/**}"
    }
  }
}
